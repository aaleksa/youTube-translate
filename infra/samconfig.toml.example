version = 0.1

[default.deploy.parameters]
stack_name = "yoytube-translaty"
resolve_s3 = true
s3_prefix = "yoytube-translaty"
region = "eu-west-1"
confirm_changeset = true
capabilities = "CAPABILITY_IAM"
parameter_overrides = "StageName=\"prod\" EmailVerificationEnabled=\"false\""

[default.build.parameters]
cached = true
parallel = true

[default.validate.parameters]
lint = true
