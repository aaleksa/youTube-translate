{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node", "aws-lambda"],
    "paths": {
      "@v2-core/*": ["../v2-core/*"]
    },
    "baseUrl": "."
  },
  "include": ["src/**/*.ts", "../v2-core/**/*.ts"]
}
