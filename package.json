{
  "name": "yoytube-translaty",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "node scripts/generate-pwa-icons.mjs && next build --webpack",
    "generate:icons": "node scripts/generate-pwa-icons.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:changes": "bash scripts/check-changes.sh",
    "test:responsive": "playwright test --project='iPhone 14' --project='Pixel 7' --project='iPad (gen 7)'",
    "test:auth-isolation": "playwright test tests/account-isolation.spec.ts --project=auth-isolation",
    "test:auth-ui": "playwright test --project=auth-ui",
    "test:auth": "playwright test --project=auth-isolation --project=auth-ui",
    "db:cleanup-test-users": "node scripts/cleanup-test-users.mjs",
    "test:responsive:ui": "playwright test --ui",
    "backend:build": "cd backend && npm run build",
    "infra:validate": "sam validate --template-file infra/template.yaml"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@react-oauth/google": "^0.13.5",
    "@serwist/next": "^9.5.11",
    "axios": "^1.17.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "google-auth-library": "^10.7.0",
    "html2pdf.js": "^0.14.0",
    "jose": "^6.2.3",
    "jsdom": "^29.1.1",
    "next": "16.2.7",
    "openai": "^6.42.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "serwist": "^9.5.11",
    "stripe": "^18.5.0",
    "youtube-transcript": "^1.3.1",
    "youtube-transcript-api": "^3.0.6",
    "yt-dlp-wrap": "^2.3.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@serwist/cli": "^9.5.11",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
