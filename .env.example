# Backend V2 mode
# local = SQLite + local JWT (default when Cognito is not configured)
# dynamodb = AWS Cognito + DynamoDB
STORAGE_BACKEND=local

# SQLite database file (relative to project root)
LOCAL_DB_PATH=data/local.db

# Secret for local JWT signing (change in production-like environments)
LOCAL_AUTH_SECRET=change-me-in-production

# OpenAI
OPENAI_API_KEY=sk-...

# AWS (only needed when STORAGE_BACKEND=dynamodb)
# AWS_REGION=eu-west-1
# COGNITO_USER_POOL_ID=eu-west-1_xxxxx
# COGNITO_CLIENT_ID=xxxxxxxx
# DYNAMODB_TABLE_NAME=yoytube-main

# Frontend
NEXT_PUBLIC_BACKEND_V2_ENABLED=true
NEXT_PUBLIC_STORAGE_BACKEND=local

# Email confirmation / password reset (requires SendGrid or Cognito email)
# Leave false until email service is connected
EMAIL_VERIFICATION_ENABLED=false
NEXT_PUBLIC_EMAIL_VERIFICATION_ENABLED=false

# Google OAuth (optional — button hidden until configured)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: http://localhost:3000
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Premium AI limits (BE-026)
# FREE_AI_DAILY_LIMIT=20
# PREMIUM_AI_DAILY_LIMIT=unlimited

# Stripe (optional — Upgrade opens Checkout when configured)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com

# Rate limiting (proxy.ts). Enabled by default for real clients.
# Set to true for local e2e / CI so Playwright auth flows don't flake.
# RATE_LIMIT_DISABLED=true

# Sentry (optional — error tracking; leave unset to disable, no account needed)
# SENTRY_DSN=https://xxx@oxxx.ingest.sentry.io/xxx
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@oxxx.ingest.sentry.io/xxx
# Set these two only if you also want build-time source map upload:
# SENTRY_ORG=your-org
# SENTRY_PROJECT=your-project
# SENTRY_AUTH_TOKEN=sntrys_...

# --- AWS deploy (when ready — see docs/INFRASTRUCTURE.md) ---
# NEXT_PUBLIC_API_BASE_URL=https://xxx.execute-api.eu-west-1.amazonaws.com/prod/api/v2
# Deploy: cd backend && npm run build && sam deploy --template-file infra/template.yaml
